# Yolias Admin on yol.yolias.com. Copy to .env.production.local (git-ignored)
# before `npm run cf:deploy:admin`. Public values only (built in).
NEXT_PUBLIC_SUPABASE_URL=https://<admin-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secrets (never in a file):
#   npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY --env admin
#   npx wrangler secret put BOS_SECRETS_KEY --env admin        (32 bytes base64 — the SAME key as today, or saved integrations can't be read)
#   npx wrangler secret put CRON_SECRET --env admin            (long random string)
#   npx wrangler secret put YOLIAS_SUPABASE_URL --env admin
#   npx wrangler secret put YOLIAS_SUPABASE_SERVICE_ROLE_KEY --env admin
#   npx wrangler secret put NEXT_PUBLIC_SUPABASE_URL --env admin
#   npx wrangler secret put NEXT_PUBLIC_SUPABASE_ANON_KEY --env admin
# ADMIN_URL, YOLIAS_SITE_URL and ADMIN_NOINDEX are set in wrangler.jsonc.
