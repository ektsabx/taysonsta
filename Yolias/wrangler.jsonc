// Yolias (customer app) on Cloudflare Workers via OpenNext (D-001, D-135).
//   www.yolias.com  — the site and the app (yolias.com redirects here)
// Secrets are never in this file: set them with `npx wrangler secret put NAME`
// (list in docs/17-production.md). Deploy: `npm run cf:deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yolias",
  "main": "custom-worker.ts",
  "compatibility_date": "2026-09-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Placement (owner 2026-10-21, lag): pages make several database calls
  // to Supabase in eu-west-1, so the Worker runs near the database, not near
  // the visitor (Egypt was served from Marseille). Targeted at the database host:
  // Smart mode had not moved it after hours.
  "placement": { "mode": "targeted", "hostname": "iudasrzqjnsutvanjrvn.supabase.co" },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "yolias"
    }
  ],
  "routes": [
    { "pattern": "www.yolias.com", "custom_domain": true },
    { "pattern": "yolias.com", "custom_domain": true }
  ],
  // Background jobs: the queue worker (/api/worker) every minute (docs/05).
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://www.yolias.com",
    "BILLING_TEST_MODE": "false"
  },
  "observability": { "enabled": true }
}
