# Copy to Yolias/.env.production.local (git-ignored) before `npm run cf:deploy`.
# Public values only: they are built into the site at build time.
NEXT_PUBLIC_SUPABASE_URL=https://<yolias-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=https://www.yolias.com
NEXT_PUBLIC_CLARITY_PROJECT_ID=ow7jcau7ol

# Secrets are NOT put in any file. Set each one on the worker:
#   cd Yolias && npx wrangler secret put SUPABASE_SERVICE_ROLE_KEY
#   cd Yolias && npx wrangler secret put WORKER_SECRET          (long random string)
#   (also the public values above, so server code sees them at runtime:)
#   cd Yolias && npx wrangler secret put NEXT_PUBLIC_SUPABASE_URL
#   cd Yolias && npx wrangler secret put NEXT_PUBLIC_SUPABASE_ANON_KEY
# Integration keys (Claude, Gemini, OpenAI, Google OAuth, Paymob) are entered
# only in Yolias Admin → Settings → Integrations (D-132), never here.
