{
  "manifest_version": 3,
  "name": "Yolias Pixel Helper",
  "short_name": "Pixel Helper",
  "version": "1.0.0",
  "description": "Verify, debug and inspect Yolias Pixel events on any website.",
  "homepage_url": "https://www.yolias.com/",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Yolias Pixel Helper",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_start", "all_frames": false }
  ]
}
