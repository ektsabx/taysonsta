# Supabase (Yolias has its own project — never the BOS one)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this app, used in magic-link redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3200

# Yolias AI (search understanding + assistant). Any of these; the order and
# models per task are set in Yolias Admin → Providers → "LLM routing", and a
# failing provider falls back to the next one. Claude is the default.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payments aren't connected yet. true = plans activate without a charge
# (recorded as test subscriptions). Keep false in production.
BILLING_TEST_MODE=false


# Email: Yolias uses the Taysonsta Resend account. Locally, `npm run local`
# fills these from the Taysonsta project (root .env.local or its Integration
# Hub). RESEND_FROM must use a domain verified in Resend.
# Hosted Supabase: set Auth → SMTP to smtp.resend.com:465, user "resend",
# password = RESEND_API_KEY, so sign-in emails go through Resend too.
RESEND_API_KEY=
RESEND_FROM=Yolias <hello@your-verified-domain>

# Background worker: /api/worker runs queued discovery jobs. Called by the
# Cloudflare Cron Trigger in production and scripts/dev-worker.mjs locally.
WORKER_SECRET=

# Email senders per category (billing@, usage@, updates@, security@, no-reply@)
# on a domain verified in Resend. Without it all mail uses RESEND_FROM.
EMAIL_DOMAIN=

# Microsoft Clarity project id (clarity.microsoft.com → Settings). Empty = not loaded.
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Google sign-in / sign-up: OAuth client from Google Cloud. Locally `npm run
# local` switches Supabase's Google provider on when both are set. Hosted
# Supabase: Auth → Providers → Google with the same client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outreach from Outlook (Microsoft app with Mail.Send). Gmail uses GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET above (add the gmail.send scope).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
